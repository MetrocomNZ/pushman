# Compose configuration. Copy to .env — nothing secret goes here; PBX
# credentials live in ./secrets/ as files.

# --- Auth0 (public values) ---------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://update-portal-api
ROLES_CLAIM=https://portal.example.com/roles

# --- Portal -------------------------------------------------------------
PORTAL_PORT=8080
TOKEN_CACHE=memory
EXPOSE_OPENAPI=false

# --- Limits -------------------------------------------------------------
WRITE_LIMIT_PER_MINUTE=10
READ_LIMIT_PER_MINUTE=60
GLOBAL_LIMIT_PER_MINUTE=120
FIRMWARE_CHECK_PER_MINUTE=4
FIRMWARE_CHECK_CONCURRENCY=5
CREDENTIAL_FAILURE_THRESHOLD=3
CREDENTIAL_COOLDOWN=300
REQUIRE_HTTPS_UPSTREAMS=true
